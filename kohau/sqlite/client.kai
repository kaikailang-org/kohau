# kohau/sqlite/client.kai — cell-wrapped SQLite client.
#
# Imported by user code as `import kohau.sqlite.client`; types
# stay bare (`SqlMsg`, `Bind`, `SqlReply` is folded into `SqlMsg`),
# functions are accessed dotted (`client.with_client(path, body)`,
# `client.exec(c, sql)`, `client.query_row(c, sql, binds)`).
#
# This is the **ergonomic surface** of kohau. The low-level
# `kohau.sqlite` module mirrors libsqlite3 one-to-one with opaque
# handles the caller must open, prepare, step, finalize, and
# close by hand. This module wraps a single connection inside an
# ahu cell (a fiber + typed mailbox + recursive step function),
# which buys three things the low-level surface cannot give:
#
#   1. **Ownership of the connection lifecycle.** The cell opens
#      the connection on spawn and closes it when it receives
#      `Shutdown` (or when `with_client`'s scope ends). Callers
#      never hold a `db: Db` handle, never forget to `close`.
#   2. **Request/reply over a typed mailbox.** Callers send a
#      high-level operation (`exec` / `query_row` / `query_scalar`)
#      and receive a structured result. They never touch
#      prepare/step/finalize.
#   3. **Ffi confinement.** The cell-fiber is the only code that
#      touches `Ffi`. Callers run in `Actor[SqlMsg]`, not `Ffi`.
#      This is the load-bearing property for the layers above
#      kohau: henua's `SqliteRepository` drops `/ Ffi` from its
#      operations and carries only `/ Actor[SqlMsg]`.
#
# ## Why `with_client(path, body)` and not `connect(path) : Pid`
#
# kaikai's region-brand walker forbids a `Pid[Msg]` from escaping
# the scope that created it (the same constraint that gives ahu's
# `with_cell` its `with_X(initial, step, body)` shape). A
# `connect(path) : Pid[SqlMsg]` form is rejected by the compiler:
# `Pid[Msg] cannot escape connect's structured-concurrency scope`.
# So the connection's lifetime is a lexical scope — `body` receives
# the client pid and may use it freely; when `body` returns, the
# scope ends. This is not a stylistic choice; it is the only shape
# the type system permits.
#
# ## Why the protocol is high-level, not a transliteration of FFI
#
# The mailbox is a process boundary. Exposing `prepare` / `step` /
# `finalize` *across* it would mean a statement handle (a raw FFI
# pointer that lives in the cell's address space) crossing the
# boundary in a reply — meaningless to the caller and a lifetime
# foot-gun. Instead the cell executes *complete, atomic operations*
# and returns *values*:
#
#   - `Exec`        — run a parameterless or value-bound statement
#                     that returns no rows (DDL, INSERT, DELETE,
#                     UPDATE, BEGIN/COMMIT). Reply carries the
#                     SQLite rc and the `changes()` count.
#   - `QueryRow`    — run a statement that returns at most one row.
#                     Reply is the row's columns as `[String]`, or
#                     "absent". This is exactly what a primary-key
#                     `find` needs.
#   - `QueryRows`   — run a statement returning any number of rows.
#                     Reply is every row's columns, in result-set
#                     order.
#   - `QueryScalar` — run a statement that returns a single Int
#                     column (COUNT, MAX, a scalar SELECT). Reply
#                     is the Int.
#
# Both query forms discover their column count from the prepared
# statement, so `SELECT *` works without the caller declaring a width.
#
# ## Scans larger than memory
#
# `QueryRows` materialises its whole result set before replying,
# which is right for a bounded query and wrong for a table scan. For
# those there are **cursors**: the cell holds the statement open
# across round-trips and the caller pulls bounded chunks.
#
# What crosses the mailbox is an id, never the statement — a `Stmt`
# is a pointer into the cell's address space, and its lifetime is
# not something a recipient could reason about. `fold_chunks` is the
# form to reach for; `open_cursor` / `fetch_chunk` / `close_cursor`
# are underneath it for consumers that decide mid-scan whether to
# continue.
#
# ## Compiled statements are reused
#
# The cell keeps compiled statements alive between operations, keyed
# by SQL text, so repeating a statement skips the parse. This is
# invisible except through `cache_stats` — and through the cost. It
# rewards binding values rather than splicing them: bound, a
# statement is one cache entry however many values run through it;
# spliced, every distinct value is a new entry that evicts the
# others. See the §*prepared statement cache* section below.
#
# ## Binds
#
# Values are bound positionally (1-indexed, SQLite convention) via
# a `[Bind]` list, covering every storage class: text, integer, real,
# blob and NULL. Binds protect every *value*: the adapter never
# concatenates a value into SQL. (Identifiers — table/column names —
# cannot be bound in SQLite and remain the caller's validation
# responsibility; see henua's `sqlite_repository.kai` §*Security*.)
#
# ## Failure
#
# Every operation returns `Result[_, SqliteError]`, and the error
# keeps libsqlite3's result code apart from its message — branch on
# `code` / `extended`, log `message`. See `SqliteError`.
#
# ## Limitations
#
#   - **Rows come back as text.** Every column is read with
#     `column_text`, so an INTEGER arrives as its decimal rendering
#     and a BLOB as whatever the text coercion produced — wrap the
#     column in `hex()` to read bytes exactly. A typed row protocol
#     (per-column storage class, decoded into a sum type) is the
#     follow-up; the reply shape would change from `[String]`.
#   - **Cursors are not transactional on their own.** A cursor sees
#     the database as it changes under it unless the scan runs
#     inside `with_tx`. Reading a table while writing to it is
#     defined but rarely what a caller means; bracket the scan when
#     it needs a stable view.
#   - **No restart-on-failure yet.** `with_client` spawns a bare
#     cell. Wrapping it in ahu's `restartable_cell` so a crashed
#     connection respawns is the next lane (it needs a reconnection
#     story: re-`open` resets the handle, but in-flight prepared
#     statements and any open transaction are lost — a real design
#     question, not a wrapper). kohau's Postgres client has the
#     first version of this in `with_reconnecting_client`.
#   - **No connection pool.** One connection per cell.
#
# ## Stability
#
# Every `pub` is `#[unstable]` for the Hanga Roa edition. The
# protocol shape (`SqlMsg`, `Bind`) and the helper surface
# (`with_client`, `exec`, `query_row`, `query_scalar`) may reshape
# as the restart story and the multi-row protocol land.

import spawn

import actor

import ahu.cell

import kohau.sqlite

# ---- protocol ----

# Positional bind value. 1-indexed per SQLite convention. Covers
# every SQLite storage class.
#
# `BindBlob` carries its bytes **hex encoded** (two digits per byte,
# no prefix or separators) — see `kohau.sqlite.bind_blob_hex` on why
# binary data crosses the FFI boundary encoded. `BindNull` is
# distinct from `BindText("")`: only the former matches `IS NULL`.
#[unstable]
pub type Bind
  = BindText(String)
  | BindInt(Int)
  | BindReal(Real)
  | BindBlob(String)
  | BindNull

# A SQLite-side failure, with the result code kept separate from the
# message.
#
#   code     — the primary result code (`SQLITE_CONSTRAINT` 19,
#              `SQLITE_BUSY` 5, …). Stable across libsqlite3 versions
#              and locales; branch on this.
#   extended — the extended code, which refines the primary one
#              (`SQLITE_CONSTRAINT_UNIQUE` 2067 vs plain 19). *Which*
#              constraint a write violated is usually the question.
#   message  — libsqlite3's text, prefixed with the operation that
#              failed. For humans and logs, not for branching: the
#              wording changes between releases.
#
# `code` is `0` for failures that never reached SQLite — a cell with
# no connection, or a protocol violation on the mailbox.
#[unstable]
pub type SqliteError = { code: Int, extended: Int, message: String }

# The reply payload. **Carries no `Pid`** — this is load-bearing.
# kaikai's region-brand walker forbids a value containing a
# `Pid[Msg]` from being *returned* out of a function (it could
# outlive the actor scope that minted the pid). The cell's
# per-operation helpers (`run_exec` etc.) produce a reply value and
# return it to the step function; if that value's type could embed a
# pid, the walker rejects the return even when the actual variant
# never holds one. Splitting the reply into its own pid-free type
# sidesteps that entirely and is also cleaner: a request needs a
# reply target, a reply never does.
#
#   ExecOk(changes)  — no-row statement succeeded; `changes` is
#                      `sqlite.changes()` after the step
#   RowFound(cols)   — ≤1-row query hit; the row's TEXT columns
#   RowAbsent        — ≤1-row query returned no rows
#   RowsFound(rows)  — multi-row query; every row's TEXT columns,
#                      in result-set order (empty list = no rows)
#   ScalarInt(n)     — scalar query returned the Int `n`
#   CacheInfo(c, l)  — statement cache: `c` compilations so far,
#                      `l` statements currently held
#   CursorReady(id)  — a cursor was opened; `id` addresses it
#   Chunk(rows, end) — the next rows from a cursor; `end` is true
#                      when the result set is exhausted
#   SqlErr(err)      — any SQLite-side failure, code and message
#[unstable]
pub type SqlReply
  = ExecOk(Int)
  | RowFound([String])
  | RowAbsent
  | RowsFound([[String]])
  | ScalarInt(Int)
  | CacheInfo(Int, Int)
  | CursorReady(Int)
  | Chunk([[String]], Bool)
  | SqlErr(SqliteError)

# The cell's mailbox message type. Mono-mailbox: kaikai's
# `Actor.send : Pid[T] -> T` ties the reply target's type to the
# active handler's Msg, so the reply travels back on the same
# mailbox as the request — wrapped in the `Reply` variant. The
# request variants carry the reply pid; `Reply` carries the pid-free
# `SqlReply`. Callers never construct or match these directly — the
# typed helpers below do that.
#
#   Exec(sql, binds, reply)        — no-row statement
#   QueryRow(sql, binds, reply)    — ≤1-row statement
#   QueryRows(sql, binds, reply)   — multi-row statement
#   QueryScalar(sql, binds, reply) — single-Int-column statement
#   Shutdown                       — close the connection, exit
#   Reply(payload)                 — a reply sent back to a caller
#[unstable]
pub type SqlMsg
  = Exec(String, [Bind], Pid[SqlMsg])
  | QueryRow(String, [Bind], Pid[SqlMsg])
  | QueryRows(String, [Bind], Pid[SqlMsg])
  | QueryScalar(String, [Bind], Pid[SqlMsg])
  | CacheStats(Pid[SqlMsg])
  | CursorOpen(String, [Bind], Pid[SqlMsg])
  | CursorFetch(Int, Int, Pid[SqlMsg])
  | CursorClose(Int)
  | Shutdown
  | Reply(SqlReply)

# ---- errors ----

# Build the error for a failure that reached SQLite, reading the
# codes and message off the connection. `op` names the step that
# failed ("prepare", "bind", "step") so the message says where.
fn db_error(db: Db, op: String) : SqliteError / Ffi = SqliteError {
  code: sqlite.errcode(db),
  extended: sqlite.extended_errcode(db),
  message: op ++ (" failed: " ++ sqlite.errmsg(db)),
}

# Build the error for a failure that never reached SQLite — no
# connection, or a mailbox protocol violation. Both codes are `0`,
# which no SQLite failure uses (`SQLITE_OK` is not an error).
fn local_error(message: String) : SqliteError = SqliteError { code: 0, extended: 0, message: message }

# Build an error carrying the caller's own reason, for a transaction
# body that decides to abort on a rule SQLite knows nothing about
# ("balance would go negative"). Carries code `0`, like every other
# failure that did not come from the database — so a caller matching
# on a SQLite code never mistakes this for one.
#[unstable]
pub fn caller_error(message: String) : SqliteError = local_error(message)

# Render an error for logs and fixtures: the message, with the codes
# appended when SQLite supplied them. The extended code is only
# shown when it says more than the primary one.
#[unstable]
pub fn error_to_string(e: SqliteError) : String = if e.code == 0 {
  e.message
} else if e.extended == e.code {
  e.message ++ (" [" ++ (int_to_string(e.code) ++ "]"))
} else {
  e.message ++ (" [" ++ (int_to_string(e.code) ++ ("/" ++ (int_to_string(e.extended) ++ "]"))))
}

# ---- cell internals ----

# Bind one positional value onto a prepared statement. Returns the
# SQLite rc (0 == SQLITE_OK).
fn apply_bind(stmt: Stmt, idx: Int, b: Bind) : Int / Ffi = match b {
  BindText(s) -> sqlite.bind_text(stmt, idx, s)
  BindInt(n) -> sqlite.bind_int(stmt, idx, n)
  BindReal(r) -> sqlite.bind_real(stmt, idx, r)
  BindBlob(hex) -> sqlite.bind_blob_hex(stmt, idx, hex)
  BindNull -> sqlite.bind_null(stmt, idx)
}

# Bind a whole list of positional values, starting at index `idx`.
# Stops and returns the first non-OK rc; returns 0 if all bind
# clean. Recursion (no loop) keeps it tail-shaped.
fn apply_binds(stmt: Stmt, idx: Int, binds: [Bind]) : Int / Ffi = match binds {
  [] -> 0
  [b, ...bs] -> {
    let rc = apply_bind(stmt, idx, b)
    if rc != 0 {
      rc
    } else {
      apply_binds(stmt, idx + 1, bs)
    }
  }
}

# Read the first `n` TEXT columns of the current row into a list.
# Builds the list head-first via recursion.
fn read_text_cols(stmt: Stmt, col: Int, n: Int) : [String] / Ffi = if col >= n {
  []
} else {
  let v = sqlite.column_text(stmt, col)
  [v, ...read_text_cols(stmt, col + 1, n)]
}

# ---- prepared statement cache ----
#
# Compiling SQL is the expensive half of a small statement, and a
# cell serving one connection runs the same handful of statements
# over and over. The cache keeps compiled statements alive across
# operations, keyed by their SQL text.
#
# **An association list, not a Map.** At this size a linear scan is
# a few string comparisons — nothing against the SQL parse it saves —
# and the list order *is* the recency order, so the LRU needs no
# second structure. Entries are held most-recently-used first: a hit
# moves its entry to the front, an insertion past capacity finalizes
# the entry that fell off the back.
#
# Keying on exact SQL text is what makes this safe: two calls share
# a statement only when they are the same statement. Values never
# enter the key — they are bound, never spliced — so the cache
# cannot confuse two calls that differ only in their parameters.
#
# `prepare_v2` handles the one invalidation case that matters: when
# DDL changes the schema under a cached statement, libsqlite3
# recompiles it inside `step` rather than failing.

# One compiled statement and the SQL it came from.
type CacheEntry = { sql: String, stmt: Stmt }

# The cell's compiled-statement store. `entries` is ordered
# most-recently-used first. `compiled` counts how many times the
# cell has called `prepare` — the cache's whole purpose is to keep
# that number below the operation count, and `cache_stats` exposes
# it so a caller (or a fixture) can check that it does.
type StmtCache = { entries: [CacheEntry], capacity: Int, compiled: Int }

# How many statements a cell keeps compiled. Sized for the working
# set of a repository-style caller (a handful of CRUD statements,
# plus BEGIN / COMMIT / ROLLBACK) with room to spare; every entry is
# one small libsqlite3 allocation.
const CACHE_CAPACITY : Int = 16

fn cache_empty() : StmtCache = StmtCache { entries: [], capacity: CACHE_CAPACITY, compiled: 0 }

# Look `sql` up, returning its entry and the remaining entries with
# it removed. The caller puts it back at the front, which is what
# makes a hit "touch" the entry.
fn cache_extract(entries: [CacheEntry], sql: String) : Option[(CacheEntry, [CacheEntry])] = match entries {
  [] -> None
  [e, ...rest] -> if e.sql == sql {
    Some((e, rest))
  } else {
    match cache_extract(rest, sql) {
      None -> None
      Some((found, others)) -> Some((found, [e, ...others]))
    }
  }
}

# Drop and finalize everything past `n` entries. Returns the kept
# prefix. Finalizing is what frees the libsqlite3 statement; losing
# the handle without it leaks until the connection closes.
fn cache_trim(entries: [CacheEntry], n: Int) : [CacheEntry] / Ffi = match entries {
  [] -> []
  [e, ...rest] -> if n <= 0 {
    let _ = sqlite.finalize(e.stmt)
    cache_trim(rest, 0)
  } else {
    [e, ...cache_trim(rest, n - 1)]
  }
}

# A statement ready to run, plus the cache that now owns it.
type Prepared = { stmt: Stmt, cache: StmtCache }

# Get a statement for `sql`, compiling it only on a miss. Either way
# the returned statement is reset and has no bindings left from a
# previous use, so the caller can bind straight onto it.
fn cache_take(cache: StmtCache, db: Db, sql: String) : Result[Prepared, SqliteError] / Ffi = match cache_extract(cache.entries, sql) {
  Some((hit, rest)) -> {
    # A hit may be mid-iteration if a previous query stopped early
    # (query_row on a multi-row result), and it still carries that
    # call's bindings. Reset rewinds it and releases any lock it
    # holds; clear_bindings drops the stale values, so a parameter
    # this call does not bind reads as NULL rather than as whatever
    # the last call put there.
    let _ = sqlite.reset(hit.stmt)
    let _ = sqlite.clear_bindings(hit.stmt)
    Ok(Prepared { stmt: hit.stmt, cache: StmtCache { entries: [hit, ...rest], capacity: cache.capacity, compiled: cache.compiled } })
  }
  None -> match sqlite.prepare(db, sql) {
    None -> Err(db_error(db, "prepare"))
    Some(stmt) -> {
      let entry = CacheEntry { sql: sql, stmt: stmt }
      let kept = cache_trim([entry, ...cache.entries], cache.capacity)
      Ok(Prepared { stmt: stmt, cache: StmtCache { entries: kept, capacity: cache.capacity, compiled: cache.compiled + 1 } })
    }
  }
}

# Hand a statement back after an operation. Resetting here rather
# than at the next take is what keeps a half-consumed query from
# holding its read lock for as long as it sits in the cache.
fn cache_release(stmt: Stmt) : Unit / Ffi {
  let _ = sqlite.reset(stmt)
  ()
}

# Number of entries the cache holds.
fn cache_size(xs: [CacheEntry]) : Int = match xs {
  [] -> 0
  [_, ...rest] -> 1 + cache_size(rest)
}

# Finalize every cached statement. Called before the connection
# closes: a statement outliving its connection is a use-after-free
# waiting to happen, and libsqlite3 refuses to close a connection
# that still has live statements.
fn cache_finalize_all(entries: [CacheEntry]) : Unit / Ffi = match entries {
  [] -> ()
  [e, ...rest] -> {
    let _ = sqlite.finalize(e.stmt)
    cache_finalize_all(rest)
  }
}

# ---- cursors ----
#
# `query_rows` materialises a whole result set before replying,
# which is the wrong shape for a scan larger than memory. A cursor
# keeps the statement open across mailbox round-trips instead, so
# the caller pulls a bounded chunk at a time.
#
# **The caller never sees the statement.** A `Stmt` is an FFI
# pointer into the cell's address space; sending one across the
# mailbox would hand out a handle whose lifetime the recipient
# cannot reason about. The reply carries an `Int` id and the cell
# keeps the mapping, so a stale id is a typed error rather than a
# dangling pointer.
#
# **A cursor's statement is never the cache's.** A cached statement
# is reset and rebound by whoever takes it next; a cursor's must
# survive untouched between fetches, and two cursors over the same
# SQL need separate statements. So a cursor compiles its own and
# finalizes it on close — cursors cost a parse, and are for the
# scans that earn it.

# A statement being consumed across several fetches. `ncols` is read
# once at open, before the first step.
type LiveCursor = { id: Int, stmt: Stmt, ncols: Int }

# The reply from one operation, plus the cache after it. Every
# `run_*` threads the cache through: it may have gained the
# statement this call compiled, or reordered by the hit it scored.
type OpResult = { reply: SqlReply, cache: StmtCache }

# Bind, then run `k` on the bound statement. Factors out the take /
# bind / release sequence every operation shares, so each one is
# left with only what it does differently. The statement is released
# on every path, including the failing ones.
fn with_stmt(cache: StmtCache, db: Db, sql: String, binds: [Bind], k: (Stmt) -> SqlReply / Ffi) : OpResult / Ffi = match cache_take(cache, db, sql) {
  Err(e) -> OpResult { reply: SqlErr(e), cache: cache }
  Ok(p) -> {
    let rc_bind = apply_binds(p.stmt, 1, binds)
    if rc_bind != 0 {
      let err = db_error(db, "bind")
      cache_release(p.stmt)
      OpResult { reply: SqlErr(err), cache: p.cache }
    } else {
      let reply = k(p.stmt)
      cache_release(p.stmt)
      OpResult { reply: reply, cache: p.cache }
    }
  }
}

# Execute a no-row statement: bind, step once. Atomic — the
# statement is fully consumed before this returns.
fn run_exec(cache: StmtCache, db: Db, sql: String, binds: [Bind]) : OpResult / Ffi = with_stmt(cache, db, sql, binds, stmt => {
  let rc_step = sqlite.step(stmt)
  let changed = sqlite.changes(db)
  # DONE, not OK, is success for a no-row statement.
  if rc_step == sqlite.SQLITE_DONE {
    ExecOk(changed)
  } else {
    SqlErr(db_error(db, "step"))
  }
})

# Execute a ≤1-row statement. The column count is discovered from
# the prepared statement, the same way `run_query_rows` does it, so
# a caller can select any number of columns without declaring the
# width. Returns RowFound(cols), RowAbsent, or SqlErr.
fn run_query_row(cache: StmtCache, db: Db, sql: String, binds: [Bind]) : OpResult / Ffi = with_stmt(cache, db, sql, binds, stmt => {
  # column_count is valid after prepare, before the first step.
  let ncols = sqlite.column_count(stmt)
  let rc_step = sqlite.step(stmt)
  if rc_step == sqlite.SQLITE_ROW {
    RowFound(read_text_cols(stmt, 0, ncols))
  } else if rc_step == sqlite.SQLITE_DONE {
    RowAbsent
  } else {
    SqlErr(db_error(db, "step"))
  }
})

# Step a prepared statement to exhaustion, accumulating every row's
# TEXT columns. `ncols` is read once from `sqlite.column_count` and
# threaded in. `acc` carries the rows gathered so far in *reverse*
# (prepended head-first for O(1) per row); the caller reverses once.
# Returns `Ok(reversed_rows)` on a clean SQLITE_DONE, or `Err(msg)`
# if a `step` returns anything other than ROW/DONE mid-iteration.
fn collect_rows(db: Db, stmt: Stmt, ncols: Int, acc: [[String]]) : Result[[[String]], SqliteError] / Ffi {
  let rc = sqlite.step(stmt)
  if rc == sqlite.SQLITE_ROW {
    let row = read_text_cols(stmt, 0, ncols)
    collect_rows(db, stmt, ncols, [row, ...acc])
  } else if rc == sqlite.SQLITE_DONE {
    # Exhausted cleanly. acc is reverse order; flip it.
    Ok(reverse_rows(acc, []))
  } else {
    Err(db_error(db, "step"))
  }
}

# Reverse a list of rows. Local rather than a stdlib import to keep
# the module's dependency surface minimal (the same discipline the
# join/split helpers in henua's adapter follow).
fn reverse_rows(xs: [[String]], acc: [[String]]) : [[String]] = match xs {
  [] -> acc
  [x, ...rest] -> reverse_rows(rest, [x, ...acc])
}

# Execute a multi-row statement. Discovers the column count from the
# prepared statement (`sqlite.column_count`), then steps to
# exhaustion. Returns RowsFound(rows) — possibly empty — or SqlErr.
fn run_query_rows(cache: StmtCache, db: Db, sql: String, binds: [Bind]) : OpResult / Ffi = with_stmt(cache, db, sql, binds, stmt => {
  # column_count is valid after prepare, before the first step.
  let ncols = sqlite.column_count(stmt)
  match collect_rows(db, stmt, ncols, []) {
    Ok(rows) -> RowsFound(rows)
    Err(e) -> SqlErr(e)
  }
})

# Execute a single-Int-column statement (COUNT, MAX, scalar SELECT).
fn run_query_scalar(cache: StmtCache, db: Db, sql: String, binds: [Bind]) : OpResult / Ffi = with_stmt(cache, db, sql, binds, stmt => {
  let rc_step = sqlite.step(stmt)
  if rc_step == sqlite.SQLITE_ROW {
    ScalarInt(sqlite.column_int(stmt, 0))
  } else {
    SqlErr(db_error(db, "step"))
  }
})

# The cell's state: the connection, the statements compiled against
# it, and the cursors currently open on it. `db` is `None` when the
# open failed, so every request replies a typed `SqlErr` instead of
# touching SQLite. Cache and cursors are meaningless without a
# connection and stay empty in that case — the statements in them
# belong to `db` and cannot outlive it.
#
# `next_id` only ever counts up, so a closed cursor's id is never
# handed out again: a fetch on a stale id fails as unknown rather
# than landing on some later cursor.
type CellState = { db: Option[Db], cache: StmtCache, cursors: [LiveCursor], next_id: Int }

# Take the cursor with `id` out of the list, returning it and the
# rest. `None` when no cursor has that id.
fn cursor_extract(cursors: [LiveCursor], id: Int) : Option[(LiveCursor, [LiveCursor])] = match cursors {
  [] -> None
  [c, ...rest] -> if c.id == id {
    Some((c, rest))
  } else {
    match cursor_extract(rest, id) {
      None -> None
      Some((found, others)) -> Some((found, [c, ...others]))
    }
  }
}

# Read up to `budget` rows from an open cursor. Returns the rows and
# whether the result set ended. Rows accumulate reversed and are
# flipped once, as `collect_rows` does.
fn fetch_rows(db: Db, cur: LiveCursor, budget: Int, acc: [[String]]) : Result[([[String]], Bool), SqliteError] / Ffi = if budget <= 0 {
  # Budget spent with the statement still mid-result: more to come.
  Ok((reverse_rows(acc, []), false))
} else {
  let rc = sqlite.step(cur.stmt)
  if rc == sqlite.SQLITE_ROW {
    let row = read_text_cols(cur.stmt, 0, cur.ncols)
    fetch_rows(db, cur, budget - 1, [row, ...acc])
  } else if rc == sqlite.SQLITE_DONE {
    Ok((reverse_rows(acc, []), true))
  } else {
    Err(db_error(db, "step"))
  }
}

# Finalize every open cursor's statement. Called before the
# connection closes, for the same reason the cache is finalized.
fn cursors_finalize_all(cursors: [LiveCursor]) : Unit / Ffi = match cursors {
  [] -> ()
  [c, ...rest] -> {
    let _ = sqlite.finalize(c.stmt)
    cursors_finalize_all(rest)
  }
}

# The error for an id that names no open cursor — closed already, or
# never opened. Carries code 0 like every failure that did not come
# from SQLite.
fn unknown_cursor(id: Int) : SqliteError = local_error("unknown cursor: " ++ int_to_string(id))

# Close the connection if the cell holds one, finalizing its
# statements first — libsqlite3 refuses to close a connection with
# live statements, and the handles die with it either way. Returns
# the SQLite rc (`SQLITE_OK` when there was nothing to close).
fn close_conn(st: CellState) : Int / Ffi = match st.db {
  Some(d) -> {
    cache_finalize_all(st.cache.entries)
    cursors_finalize_all(st.cursors)
    sqlite.close(d)
  }
  None -> 0
}

# The cell's step function. Each request runs to completion, replies,
# and carries the (possibly grown or reordered) cache forward.
#
# Both query forms discover their column count from the prepared
# statement, so they handle arbitrary SELECTs — including `SELECT *`
# — without the caller declaring a width.
fn sql_step(st: CellState, msg: SqlMsg) : StepResult[CellState] / Actor[SqlMsg] + Ffi = match msg {
  Exec(sql, binds, reply_to) -> cell.keep(dispatch(st, reply_to, (c, d) => run_exec(c, d, sql, binds)))
  QueryRow(sql, binds, reply_to) -> cell.keep(dispatch(st, reply_to, (c, d) => run_query_row(c, d, sql, binds)))
  QueryRows(sql, binds, reply_to) -> cell.keep(dispatch(st, reply_to, (c, d) => run_query_rows(c, d, sql, binds)))
  QueryScalar(sql, binds, reply_to) -> cell.keep(dispatch(st, reply_to, (c, d) => run_query_scalar(c, d, sql, binds)))
  CacheStats(reply_to) -> {
    # Answered from the cache alone: it needs no connection, so it
    # reports honestly even on a cell whose open failed.
    Actor.send(reply_to, Reply(CacheInfo(st.cache.compiled, cache_size(st.cache.entries))))
    cell.keep(st)
  }
  CursorOpen(sql, binds, reply_to) -> cell.keep(handle_cursor_open(st, sql, binds, reply_to))
  CursorFetch(id, budget, reply_to) -> cell.keep(handle_cursor_fetch(st, id, budget, reply_to))
  CursorClose(id) -> cell.keep(handle_cursor_close(st, id))
  Shutdown -> {
    let _ = close_conn(st)
    cell.cell_done()
  }
  Reply(_) ->
  # A `Reply` never arrives at the cell's own mailbox; if one does
  # (a misrouted message), ignore it and keep running.
  cell.keep(st)
}

# Compile a statement for a cursor, bind it, and register it under a
# fresh id. Unlike the pooled operations this does not touch the
# cache — see §*cursors* on why a cursor owns its statement.
fn handle_cursor_open(st: CellState, sql: String, binds: [Bind], reply_to: Pid[SqlMsg]) : CellState / Actor[SqlMsg] + Ffi = match st.db {
  None -> {
    Actor.send(reply_to, Reply(SqlErr(local_error("no connection: open failed"))))
    st
  }
  Some(d) -> match sqlite.prepare(d, sql) {
    None -> {
      Actor.send(reply_to, Reply(SqlErr(db_error(d, "prepare"))))
      st
    }
    Some(stmt) -> {
      let rc_bind = apply_binds(stmt, 1, binds)
      if rc_bind != 0 {
        let err = db_error(d, "bind")
        let _ = sqlite.finalize(stmt)
        Actor.send(reply_to, Reply(SqlErr(err)))
        st
      } else {
        let cur = LiveCursor { id: st.next_id, stmt: stmt, ncols: sqlite.column_count(stmt) }
        Actor.send(reply_to, Reply(CursorReady(st.next_id)))
        CellState { db: st.db, cache: st.cache, cursors: [cur, ...st.cursors], next_id: st.next_id + 1 }
      }
    }
  }
}

# Pull the next chunk from a cursor. A cursor that reaches the end
# of its result set, or hits an error, is finalized and dropped here
# — so the common path (read until `end`) needs no explicit close,
# and a failed cursor cannot be fetched from again.
fn handle_cursor_fetch(st: CellState, id: Int, budget: Int, reply_to: Pid[SqlMsg]) : CellState / Actor[SqlMsg] + Ffi = match st.db {
  None -> {
    Actor.send(reply_to, Reply(SqlErr(local_error("no connection: open failed"))))
    st
  }
  Some(d) -> match cursor_extract(st.cursors, id) {
    None -> {
      Actor.send(reply_to, Reply(SqlErr(unknown_cursor(id))))
      st
    }
    Some((cur, rest)) -> match fetch_rows(d, cur, budget, []) {
      Err(e) -> {
        let _ = sqlite.finalize(cur.stmt)
        Actor.send(reply_to, Reply(SqlErr(e)))
        CellState { db: st.db, cache: st.cache, cursors: rest, next_id: st.next_id }
      }
      Ok((rows, done)) -> {
        Actor.send(reply_to, Reply(Chunk(rows, done)))
        if done {
          let _ = sqlite.finalize(cur.stmt)
          CellState { db: st.db, cache: st.cache, cursors: rest, next_id: st.next_id }
        } else {
          # Still live: put it back at the front, where the next
          # fetch will find it first.
          CellState { db: st.db, cache: st.cache, cursors: [cur, ...rest], next_id: st.next_id }
        }
      }
    }
  }
}

# Close a cursor early. Fire-and-forget, and a no-op for an id that
# is already gone — a caller abandoning a scan should not have to
# know whether it happened to end on the last chunk.
fn handle_cursor_close(st: CellState, id: Int) : CellState / Ffi = match cursor_extract(st.cursors, id) {
  None -> st
  Some((cur, rest)) -> {
    let _ = sqlite.finalize(cur.stmt)
    CellState { db: st.db, cache: st.cache, cursors: rest, next_id: st.next_id }
  }
}

# Run one operation, send its reply, and return the state to carry
# forward. With no connection the reply is the typed open-failure and
# the state is untouched.
fn dispatch(st: CellState, reply_to: Pid[SqlMsg], op: (StmtCache, Db) -> OpResult / Ffi) : CellState / Actor[SqlMsg] + Ffi = match st.db {
  None -> {
    Actor.send(reply_to, Reply(SqlErr(local_error("no connection: open failed"))))
    st
  }
  Some(d) -> {
    let r = op(st.cache, d)
    Actor.send(reply_to, Reply(r.reply))
    CellState { db: st.db, cache: r.cache, cursors: st.cursors, next_id: st.next_id }
  }
}

# The cell dispatch loop, spawned as its own fiber by `with_client`.
# Mirrors ahu's internal `cell_loop` but lives here so `with_client`
# can hand-spawn it (see the module header on why `with_cell` is not
# used: it shares one row variable between step and body, which would
# leak this loop's `Ffi` into `with_client`'s body).
fn sql_loop(st: CellState) : Unit / Actor[SqlMsg] + Ffi {
  let msg = Actor.receive()
  match sql_step(st, msg) {
    Continue(s) -> sql_loop(s)
    Done -> ()
  }
}

# ---- public surface ----

# Open a SQLite connection, run it inside a cell, and call `body`
# with the client pid. The connection is opened on entry and the
# cell-fiber drives it; `body` talks to the cell via the typed
# helpers below. When `body` finishes, it is responsible for sending
# `Shutdown` (the helpers expose `close`); the cell then closes the
# connection and exits.
#
# The effect rows are the load-bearing part of this signature:
#
#   - `with_client`'s row carries `Ffi` (it opens the connection and
#     spawns the FFI-touching loop) and `Spawn` (it spawns the cell)
#     and `Actor[SqlMsg]` (the caller's mailbox the helpers use).
#   - `body`'s row is `Actor[SqlMsg] + e` — **no `Ffi`**. The cell
#     is the sole owner of the FFI boundary. This is what lets henua
#     run its repository operations in `Actor[SqlMsg]` instead of
#     `Ffi`.
#
# The `+ e` on body lets callers thread their own effects (Console
# for tracing, etc.) without `with_client` having to know about them.
#
# On open failure (`sqlite.open` returns `None`) the cell spawns
# without a connection: every helper call replies
# `SqlErr(local_error("no connection: open failed"))` — fail-fast and typed — and
# `close` still shuts the cell down cleanly. A caller that wants to
# fail before entering `body` can check by issuing a trivial
# `exec(c, "SELECT 1")` first.
#
# ## Journal mode
#
# The connection is switched to **WAL** on open. WAL lets one writer
# and any number of readers proceed concurrently, where the rollback
# journal makes them exclude each other — the mode that matches a
# connection owned by a fiber other fibers query through.
#
# The switch is persistent (it is a property of the database file,
# not the connection) and is a no-op where it does not apply: an
# in-memory database stays `memory`, and a file on a filesystem
# without shared-memory support stays whatever it was. Failure is
# deliberately not surfaced — a database that cannot take WAL is
# still perfectly usable, just less concurrent. A caller that needs
# a different mode issues `PRAGMA journal_mode = ...` through
# `exec` and it wins.
#[unstable]
pub fn with_client[R, e](path: String, body: (Pid[SqlMsg]) -> R / Actor[SqlMsg] + e) : R / Spawn + Ffi + Actor[SqlMsg] + e {
  let db = sqlite.open(path)
  let _ = set_wal(db)
  let pid = spawn_actor(() => sql_loop(CellState { db: db, cache: cache_empty(), cursors: [], next_id: 1 }))
  body(pid)
}

# Put the connection in WAL journal mode. Returns the SQLite rc, or
# `SQLITE_OK` when there is no connection to configure. The result
# is advisory — see `with_client` on why a refusal is not fatal.
fn set_wal(db: Option[Db]) : Int / Ffi = match db {
  Some(d) -> sqlite.exec(d, "PRAGMA journal_mode = WAL")
  None -> 0
}

# Unwrap a mailbox message into its reply payload. `cell.ask`
# returns *any* `SqlMsg` (the mailbox can in principle hold a stray
# request), so the helpers first peel the `Reply` wrapper. A
# non-`Reply` message is a protocol violation — it means something
# other than this cell sent to the caller's mailbox between the ask
# and the receive. We surface it as `SqlErr` rather than guess.
fn expect_reply(msg: SqlMsg) : SqlReply = match msg {
  Reply(payload) -> payload
  Exec(_, _, _) -> SqlErr(local_error("protocol: stray Exec on reply mailbox"))
  QueryRow(_, _, _) -> SqlErr(local_error("protocol: stray QueryRow on reply mailbox"))
  QueryRows(_, _, _) -> SqlErr(local_error("protocol: stray QueryRows on reply mailbox"))
  QueryScalar(_, _, _) -> SqlErr(local_error("protocol: stray QueryScalar on reply mailbox"))
  CacheStats(_) -> SqlErr(local_error("protocol: stray CacheStats on reply mailbox"))
  CursorOpen(_, _, _) -> SqlErr(local_error("protocol: stray CursorOpen on reply mailbox"))
  CursorFetch(_, _, _) -> SqlErr(local_error("protocol: stray CursorFetch on reply mailbox"))
  CursorClose(_) -> SqlErr(local_error("protocol: stray CursorClose on reply mailbox"))
  Shutdown -> SqlErr(local_error("protocol: stray Shutdown on reply mailbox"))
}

# Run a no-row statement (DDL, INSERT, DELETE, UPDATE, BEGIN/COMMIT).
# Returns `Ok(changes)` — the row count affected — on success, or
# `Err(msg)` on a SQLite failure. Lives in `Actor[SqlMsg]` — no
# `Ffi` at the call site.
#[unstable]
pub fn exec(c: Pid[SqlMsg], sql: String, binds: [Bind]) : Result[Int, SqliteError] / Actor[SqlMsg] {
  let reply = cell.ask(c, me => Exec(sql, binds, me))
  match expect_reply(reply) {
    ExecOk(changed) -> Ok(changed)
    SqlErr(msg) -> Err(msg)
    RowFound(_) -> 
    # These payloads cannot answer an `Exec`; treat as a violation.
    Err(local_error("protocol: RowFound reply to Exec"))
    RowAbsent -> Err(local_error("protocol: RowAbsent reply to Exec"))
    RowsFound(_) -> Err(local_error("protocol: RowsFound reply to Exec"))
    ScalarInt(_) -> Err(local_error("protocol: ScalarInt reply to Exec"))
    CacheInfo(_, _) -> Err(local_error("protocol: CacheInfo reply to Exec"))
    CursorReady(_) -> Err(local_error("protocol: CursorReady reply to Exec"))
    Chunk(_, _) -> Err(local_error("protocol: Chunk reply to Exec"))
  }
}

# Run a ≤1-row query. Returns `Ok(Some(cols))` if a row was found
# (cols are the row's TEXT columns), `Ok(None)` if no row matched,
# or `Err(msg)` on a SQLite failure. v1 reads a single TEXT column
# (the `find`-by-key shape); the returned list has length 1 on a hit.
#[unstable]
pub fn query_row(c: Pid[SqlMsg], sql: String, binds: [Bind]) : Result[Option[[String]], SqliteError] / Actor[SqlMsg] {
  let reply = cell.ask(c, me => QueryRow(sql, binds, me))
  match expect_reply(reply) {
    RowFound(cols) -> Ok(Some(cols))
    RowAbsent -> Ok(None)
    SqlErr(msg) -> Err(msg)
    ExecOk(_) -> Err(local_error("protocol: ExecOk reply to QueryRow"))
    RowsFound(_) -> Err(local_error("protocol: RowsFound reply to QueryRow"))
    ScalarInt(_) -> Err(local_error("protocol: ScalarInt reply to QueryRow"))
    CacheInfo(_, _) -> Err(local_error("protocol: CacheInfo reply to QueryRow"))
    CursorReady(_) -> Err(local_error("protocol: CursorReady reply to QueryRow"))
    Chunk(_, _) -> Err(local_error("protocol: Chunk reply to QueryRow"))
  }
}

# Run a multi-row query. Returns `Ok(rows)` — every result row's
# TEXT columns in result-set order, possibly empty — or `Err(msg)`
# on a SQLite failure. The column count is discovered from the
# prepared statement, so `SELECT *` and explicit column lists both
# work without the caller declaring a width.
#
# v1 materialises the entire result set in memory before replying:
# the reply is a single `[[String]]`, not a stream. This is the
# right shape for the bounded result sets the layers above kohau
# need today (henua's `repository.all` over a per-aggregate table).
# A streaming / chunked protocol (or an ahu `Stream` source) for
# unbounded scans is a follow-up — see `docs/design.md`.
#[unstable]
pub fn query_rows(c: Pid[SqlMsg], sql: String, binds: [Bind]) : Result[[[String]], SqliteError] / Actor[SqlMsg] {
  let reply = cell.ask(c, me => QueryRows(sql, binds, me))
  match expect_reply(reply) {
    RowsFound(rows) -> Ok(rows)
    SqlErr(msg) -> Err(msg)
    ExecOk(_) -> Err(local_error("protocol: ExecOk reply to QueryRows"))
    RowFound(_) -> Err(local_error("protocol: RowFound reply to QueryRows"))
    RowAbsent -> Err(local_error("protocol: RowAbsent reply to QueryRows"))
    ScalarInt(_) -> Err(local_error("protocol: ScalarInt reply to QueryRows"))
    CacheInfo(_, _) -> Err(local_error("protocol: CacheInfo reply to QueryRows"))
    CursorReady(_) -> Err(local_error("protocol: CursorReady reply to QueryRows"))
    Chunk(_, _) -> Err(local_error("protocol: Chunk reply to QueryRows"))
  }
}

# Run a single-Int-column query (COUNT, MAX, scalar SELECT).
# Returns `Ok(n)` or `Err(msg)`.
#[unstable]
pub fn query_scalar(c: Pid[SqlMsg], sql: String, binds: [Bind]) : Result[Int, SqliteError] / Actor[SqlMsg] {
  let reply = cell.ask(c, me => QueryScalar(sql, binds, me))
  match expect_reply(reply) {
    ScalarInt(n) -> Ok(n)
    SqlErr(msg) -> Err(msg)
    ExecOk(_) -> Err(local_error("protocol: ExecOk reply to QueryScalar"))
    RowFound(_) -> Err(local_error("protocol: RowFound reply to QueryScalar"))
    RowAbsent -> Err(local_error("protocol: RowAbsent reply to QueryScalar"))
    RowsFound(_) -> Err(local_error("protocol: RowsFound reply to QueryScalar"))
    CacheInfo(_, _) -> Err(local_error("protocol: CacheInfo reply to QueryScalar"))
    CursorReady(_) -> Err(local_error("protocol: CursorReady reply to QueryScalar"))
    Chunk(_, _) -> Err(local_error("protocol: Chunk reply to QueryScalar"))
  }
}

# Ask the cell about its statement cache. Returns
# `Ok((compiled, held))`: how many times it has compiled a statement
# since it spawned, and how many it currently holds.
#
# `compiled` is the number worth watching. It rises once per *new*
# statement and stays flat while the same SQL is reused, so a caller
# whose workload is a fixed set of statements should see it settle.
# One that keeps climbing means SQL is being built with values
# spliced in — each variant is a distinct cache key that evicts the
# others — which is also the shape that invites injection. Bind
# values instead.
#[unstable]
pub fn cache_stats(c: Pid[SqlMsg]) : Result[(Int, Int), SqliteError] / Actor[SqlMsg] {
  let reply = cell.ask(c, me => CacheStats(me))
  match expect_reply(reply) {
    CacheInfo(compiled, held) -> Ok((compiled, held))
    SqlErr(e) -> Err(e)
    ExecOk(_) -> Err(local_error("protocol: ExecOk reply to CacheStats"))
    RowFound(_) -> Err(local_error("protocol: RowFound reply to CacheStats"))
    RowAbsent -> Err(local_error("protocol: RowAbsent reply to CacheStats"))
    RowsFound(_) -> Err(local_error("protocol: RowsFound reply to CacheStats"))
    ScalarInt(_) -> Err(local_error("protocol: ScalarInt reply to CacheStats"))
    CursorReady(_) -> Err(local_error("protocol: CursorReady reply to CacheStats"))
    Chunk(_, _) -> Err(local_error("protocol: Chunk reply to CacheStats"))
  }
}

# A handle to an open cursor. Wraps the cell-side id rather than
# exposing a bare `Int`, so it cannot be confused with a row count
# or a chunk size at a call site.
#[unstable]
pub type Cursor = { id: Int }

# Open a cursor over `sql`. The statement stays compiled and
# positioned in the cell between fetches, so rows arrive in bounded
# chunks instead of all at once.
#
# The caller owns the cursor from here: read it to the end (the last
# chunk reports `true`, and the cell drops it) or `close_cursor` it
# early. `fold_chunks` does that bookkeeping and is the better
# starting point; reach for this when the consumer needs to decide
# mid-scan whether to keep going.
#[unstable]
pub fn open_cursor(c: Pid[SqlMsg], sql: String, binds: [Bind]) : Result[Cursor, SqliteError] / Actor[SqlMsg] {
  let reply = cell.ask(c, me => CursorOpen(sql, binds, me))
  match expect_reply(reply) {
    CursorReady(id) -> Ok(Cursor { id: id })
    SqlErr(e) -> Err(e)
    ExecOk(_) -> Err(local_error("protocol: ExecOk reply to CursorOpen"))
    RowFound(_) -> Err(local_error("protocol: RowFound reply to CursorOpen"))
    RowAbsent -> Err(local_error("protocol: RowAbsent reply to CursorOpen"))
    RowsFound(_) -> Err(local_error("protocol: RowsFound reply to CursorOpen"))
    ScalarInt(_) -> Err(local_error("protocol: ScalarInt reply to CursorOpen"))
    CacheInfo(_, _) -> Err(local_error("protocol: CacheInfo reply to CursorOpen"))
    Chunk(_, _) -> Err(local_error("protocol: Chunk reply to CursorOpen"))
  }
}

# Pull at most `max_rows` more rows. Returns the rows and whether the
# result set is now exhausted — `true` means this was the last chunk
# and the cursor is gone; fetching again reports an unknown cursor.
#
# A short chunk does **not** mean the end: a chunk can be short only
# when the rows ran out, but the flag is the signal to trust.
#[unstable]
pub fn fetch_chunk(c: Pid[SqlMsg], cur: Cursor, max_rows: Int) : Result[([[String]], Bool), SqliteError] / Actor[SqlMsg] {
  let reply = cell.ask(c, me => CursorFetch(cur.id, max_rows, me))
  match expect_reply(reply) {
    Chunk(rows, done) -> Ok((rows, done))
    SqlErr(e) -> Err(e)
    ExecOk(_) -> Err(local_error("protocol: ExecOk reply to CursorFetch"))
    RowFound(_) -> Err(local_error("protocol: RowFound reply to CursorFetch"))
    RowAbsent -> Err(local_error("protocol: RowAbsent reply to CursorFetch"))
    RowsFound(_) -> Err(local_error("protocol: RowsFound reply to CursorFetch"))
    ScalarInt(_) -> Err(local_error("protocol: ScalarInt reply to CursorFetch"))
    CacheInfo(_, _) -> Err(local_error("protocol: CacheInfo reply to CursorFetch"))
    CursorReady(_) -> Err(local_error("protocol: CursorReady reply to CursorFetch"))
  }
}

# Abandon a cursor before its end. Fire-and-forget, and harmless on
# a cursor that already finished — a consumer that stops early does
# not have to know whether it happened to land on the last chunk.
#[unstable]
pub fn close_cursor(c: Pid[SqlMsg], cur: Cursor) : Unit / Actor[SqlMsg] = Actor.send(c, CursorClose(cur.id))

# Fold `step` over a result set, `chunk_size` rows at a time, never
# holding more than one chunk in memory. This is the streaming
# counterpart of `query_rows` and the form most consumers want.
#
# The cursor is closed on every exit: normal end, a SQLite failure
# mid-scan, or `step` deciding to stop. `step` returns
# `FoldMore(acc)` to keep going or `FoldStop(acc)` to end the scan early
# — a `LIMIT` the consumer applies rather than the query.
#
# ```kai
# # Total a column without materialising the table.
# fold_chunks(c, "SELECT amount FROM ledger", [], 500, 0, (sum, rows) =>
#   FoldMore(sum + sum_first_column(rows)))
# ```
#[unstable]
pub fn fold_chunks[a, e](c: Pid[SqlMsg], sql: String, binds: [Bind], chunk_size: Int, init: a, step: (a, [[String]]) -> FoldStep[a] / Actor[SqlMsg] + e) : Result[a, SqliteError] / Actor[SqlMsg] + e = match open_cursor(c, sql, binds) {
  Err(e) -> Err(e)
  Ok(cur) -> fold_loop(c, cur, chunk_size, init, step)
}

# What a `fold_chunks` step decides after seeing a chunk.
#[unstable]
pub type FoldStep[a]
  = FoldMore(a)
  | FoldStop(a)

# Drive the cursor until the result set ends, `step` stops, or a
# fetch fails. Closes the cursor on the two paths where the cell has
# not already dropped it.
fn fold_loop[a, e](c: Pid[SqlMsg], cur: Cursor, chunk_size: Int, acc: a, step: (a, [[String]]) -> FoldStep[a] / Actor[SqlMsg] + e) : Result[a, SqliteError] / Actor[SqlMsg] + e = match fetch_chunk(c, cur, chunk_size) {
  # A failed fetch has already finalized the cursor cell-side.
  Err(e) -> Err(e)
  Ok((rows, done)) -> match step(acc, rows) {
    FoldStop(final) -> {
      # Stopping early leaves the cursor open unless this was the
      # last chunk; closing an already-dropped one is a no-op.
      if done {
        ()
      } else {
        close_cursor(c, cur)
      }
      Ok(final)
    }
    FoldMore(next) -> if done {
      Ok(next)
    } else {
      fold_loop(c, cur, chunk_size, next, step)
    }
  }
}

# Tell the cell to close its connection and exit. Fire-and-forget:
# the caller does not wait for an acknowledgement (the cell exits
# rather than replying). Call this once at the end of a `with_client`
# body. After `close`, the client pid is dead; further helper calls
# park forever on a reply that never comes.
#[unstable]
pub fn close(c: Pid[SqlMsg]) : Unit / Actor[SqlMsg] = Actor.send(c, Shutdown)

# Run `body` inside a transaction scope. `BEGIN` on entry; `COMMIT`
# if `body` returns `Ok`, `ROLLBACK` if it returns `Err`. The result
# of `body` is returned to the caller — `with_tx` does not invent
# its own success/failure value, it threads the body's `Result`
# through (committing or rolling back as a side effect of which arm
# it is).
#
# ## Why the body returns a `Result`, not "any value"
#
# kaikai has no exceptions; the failure channel for a transactional
# body is the value it returns. A body that wants to roll back
# returns `Err(reason)`; one that wants to commit returns `Ok(value)`.
# This is honest to the language — there is no hidden control flow
# that "throws" mid-body and triggers a rollback behind the caller's
# back. Every `client.exec` / `query_*` call already returns a
# `Result`, so a body composed of them threads its failures out
# naturally (match-and-early-`Err`, or the `?`-style propagation when
# that lands). A body that ignores a failed inner op and returns
# `Ok` anyway WILL commit — that is the caller's choice, made
# explicit by the return value.
#
# ## Why `tx` is the same pid as `c`
#
# SQLite transactions are per-*connection*, not per-statement: `BEGIN`
# / `COMMIT` / `ROLLBACK` bracket every statement issued on the same
# connection in between. The cell owns one connection, so the
# "transaction handle" handed to `body` is just the client pid
# itself. Passing it as `body`'s argument (rather than letting the
# body close over `c`) keeps the call site reading like a scope and
# documents that statements inside `body` are the ones bracketed.
#
# ## v1 limitations
#
#   - **No nesting.** A `with_tx` inside another `with_tx` on the
#     same client issues a nested `BEGIN`, which SQLite rejects
#     ("cannot start a transaction within a transaction"). The inner
#     `BEGIN` surfaces as `Err` and the inner scope rolls back;
#     savepoint-based nesting (`SAVEPOINT` / `RELEASE` /
#     `ROLLBACK TO`) is the follow-up if a fixture needs it.
#   - **No isolation-level control.** v1 issues a plain `BEGIN`
#     (SQLite's default deferred transaction). `BEGIN IMMEDIATE` /
#     `EXCLUSIVE` land via a `with_tx_mode` variant when a consumer
#     needs the locking semantics.
#   - **Rollback errors are swallowed.** If `body` returns `Err` and
#     the subsequent `ROLLBACK` itself fails, the body's original
#     `Err` is what propagates — the rollback failure is not
#     surfaced (it would mask the more useful original cause). The
#     connection may be left in an unexpected state in that rare
#     case; the cell's per-op statement isolation limits the blast
#     radius.
#[unstable]
pub fn with_tx[R, e](c: Pid[SqlMsg], body: (Pid[SqlMsg]) -> Result[R, SqliteError] / Actor[SqlMsg] + e) : Result[R, SqliteError] / Actor[SqlMsg] + e = with_tx_mode(c, Deferred, body)

# Locking mode for a transaction scope, as the `BEGIN` variant it
# emits. SQLite takes locks lazily by default, which is the right
# choice for a reader and the wrong one for a read-then-write:
#
#   Deferred  — `BEGIN`. No lock until the first statement needs
#               one. A transaction that reads and then writes can
#               fail with SQLITE_BUSY at the *write*, after its read
#               already saw a snapshot another writer has since
#               changed. Upgrading mid-transaction is what deadlocks
#               under concurrency.
#   Immediate — `BEGIN IMMEDIATE`. Takes the write lock up front, so
#               contention surfaces at BEGIN — before the body has
#               read anything it would have to discard. This is the
#               mode a read-modify-write wants.
#   Exclusive — `BEGIN EXCLUSIVE`. Also locks out readers. Only
#               needed for whole-database operations; in WAL mode it
#               additionally blocks readers that would otherwise run
#               concurrently.
#[unstable]
pub type TxMode
  = Deferred
  | Immediate
  | Exclusive

# The BEGIN statement a mode emits.
fn begin_sql(mode: TxMode) : String = match mode {
  Deferred -> "BEGIN"
  Immediate -> "BEGIN IMMEDIATE"
  Exclusive -> "BEGIN EXCLUSIVE"
}

# Re-label an error with the transaction step that produced it,
# keeping both result codes intact — a caller branching on
# `SQLITE_BUSY` still sees it after the prefix.
fn prefixed(e: SqliteError, prefix: String) : SqliteError = SqliteError {
  code: e.code,
  extended: e.extended,
  message: prefix ++ (": " ++ e.message),
}

# `with_tx` with an explicit locking mode — see `TxMode`. Identical
# in every other respect, including the v1 limitations above.
#[unstable]
pub fn with_tx_mode[R, e](c: Pid[SqlMsg], mode: TxMode, body: (Pid[SqlMsg]) -> Result[R, SqliteError] / Actor[SqlMsg] + e) : Result[R, SqliteError] / Actor[SqlMsg] + e = match exec(c, begin_sql(mode), []) {
  Err(e) -> Err(prefixed(e, "BEGIN failed"))
  Ok(_) -> {
    let result = body(c)
    match result {
      Ok(_) -> match exec(c, "COMMIT", []) {
        Ok(_) -> result
        Err(e) -> Err(prefixed(e, "COMMIT failed"))
      }
      Err(_) -> {
        # Roll back; the body's original Err is what propagates,
        # so a rollback failure does not mask the real cause.
        let _ = exec(c, "ROLLBACK", [])
        result
      }
    }
  }
}
